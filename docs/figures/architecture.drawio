<mxfile host="app.diagrams.net" type="device">
  <diagram id="odyssey-architecture" name="Odyssey architecture">
    <mxGraphModel dx="900" dy="740" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Stage labels -->
        <mxCell id="lbl_data" value="DATA" style="text;html=1;rotation=-90;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#5B7A99;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="-24" y="50" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_tok" value="TOKENIZATION" style="text;html=1;rotation=-90;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#6E8A4E;fontFamily=Helvetica;" vertex="1" parent="1">
