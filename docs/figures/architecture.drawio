        <mxCell id="e_t1_t2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6270;endArrow=block;endFill=1;exitX=1;exitY=0.86;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t1" target="t2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Stage 3: MODEL -->
        <mxCell id="m1" value="&lt;b&gt;Hybrid Mamba-2 + attention backbone&lt;/b&gt;&lt;br&gt;streamed over the whole record in 512-token chunks, carried recurrent state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECE2;strokeColor=#A67B4B;fontFamily=Helvetica;fontSize=11;fontColor=#23272E;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="600" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="m_note" value="&lt;i&gt;No-bottleneck baseline variant: same backbone and heads&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#9AA1AB;fontFamily=Helvetica;fontSize=10;fontColor=#4A5058;" vertex="1" parent="1">
