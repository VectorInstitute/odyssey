          <mxGeometry x="40" y="32" width="248" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;MEDS extraction&lt;/b&gt;&lt;br&gt;meds-extract, MESSY specs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EDF3;strokeColor=#5B7A99;fontFamily=Helvetica;fontSize=11;fontColor=#23272E;" vertex="1" parent="1">
          <mxGeometry x="334" y="32" width="248" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;MEDS events&lt;/b&gt;&lt;br&gt;subject, time, code, numeric value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EDF3;strokeColor=#5B7A99;fontFamily=Helvetica;fontSize=11;fontColor=#23272E;" vertex="1" parent="1">
