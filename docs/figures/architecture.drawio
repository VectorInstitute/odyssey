        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;Concept bottleneck&lt;/b&gt;&lt;br&gt;k named clinical concepts: supervised probabilities, active/inactive embedding pairs&lt;br&gt;+ 1 unknown residual channel (orthogonality-penalized)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECE2;strokeColor=#A67B4B;fontFamily=Helvetica;fontSize=11;fontColor=#23272E;" vertex="1" parent="1">
          <mxGeometry x="40" y="378" width="600" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="h1" value="&lt;b&gt;Next-event distribution&lt;/b&gt;&lt;br&gt;bundle-invariant, family-restricted loss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECE2;strokeColor=#A67B4B;fontFamily=Helvetica;fontSize=11;fontColor=#23272E;" vertex="1" parent="1">
          <mxGeometry x="40" y="474" width="264" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="&lt;b&gt;Time-to-next-event hazard&lt;/b&gt;&lt;br&gt;log-time bins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECE2;strokeColor=#A67B4B;fontFamily=Helvetica;fontSize=11;fontColor=#23272E;" vertex="1" parent="1">
          <mxGeometry x="326" y="474" width="264" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="&lt;b&gt;Per-event hazard heads&lt;/b&gt;&lt;br&gt;vasopressor start, ICU admission, AKI, death (right-censored; linear or MLP readout)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECE2;strokeColor=#A67B4B;fontFamily=Helvetica;fontSize=11;fontColor=#23272E;" vertex="1" parent="1">
          <mxGeometry x="612" y="474" width="264" height="76" as="geometry"/>
