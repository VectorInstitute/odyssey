          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Stage 2: TOKENIZATION -->
        <mxCell id="t1" value="&lt;b&gt;Token stream per patient&lt;/b&gt;&lt;br&gt;&amp;bull; code + value bin (clinical ranges keyed by LOINC, quantile fallback)&lt;br&gt;&amp;bull; standardized value channel (opt-in)&lt;br&gt;&amp;bull; inter-event time, age, visit structure&lt;br&gt;&amp;bull; static facts (sex, race) as leading tokens&lt;br&gt;&amp;bull; medication codes normalized to ingredient (HICL dictionary on eICU)&lt;br&gt;&amp;bull; concept labels from a canonical LOINC-keyed rule registry" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#EAF0E2;strokeColor=#6E8A4E;fontFamily=Helvetica;fontSize=11;fontColor=#23272E;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="600" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;Concept labels&lt;/b&gt;&lt;br&gt;rule-derived supervision targets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0E2;strokeColor=#6E8A4E;fontFamily=Helvetica;fontSize=11;fontColor=#23272E;" vertex="1" parent="1">
          <mxGeometry x="672" y="216" width="204" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="e_d3_t1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6270;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="t1">
