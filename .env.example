# Copy to .env (git-ignored) and fill in GEMINI credentials. See
# docs/gemini.md for the full workflow and governance rules. .env is loaded
# automatically at import time by odyssey.data.gemini.config; real
# environment variables always take precedence over values set here.

# Required (secrets -- no defaults in code):
GEMINI_DB_USER=your_username
GEMINI_DB_PASS=your_password

# Required (no defaults -- the odyssey-specific database/data cut is not
# decided yet, see docs/gemini.md's "GEMINI to MEDS" section):
GEMINI_DB_NAME=
GEMINI_DATACUT=

# Optional overrides (defaults shown):
# GEMINI_DB_HOST=db.gemini-hpc.ca
# GEMINI_DB_PORT=5432

# Alternatively, supply the whole SQLAlchemy URL and skip the parts above:
# GEMINI_DB_URL=postgresql+psycopg2://user:pass@db.gemini-hpc.ca:5432/dbname
